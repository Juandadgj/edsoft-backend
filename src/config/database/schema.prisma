generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model absence {
  id_absence    Int     @id @default(autoincrement())
  id_student    Int?
  id_course     Int?
  day           Int?
  month         Int?
  year          Int?
  hours         Int?
  justification String? @db.Char(2)
  reason        String? @db.VarChar(245)
  period        Int?
}

model achievement {
  id_achievement Int     @id @default(autoincrement())
  id_course      Int?
  period         Int?
  description    String? @db.LongText
}

model achievement_student {
  id_achie_stu   Int     @id @default(autoincrement())
  id_achievement Int?
  id_student     Int?
  score          Float?
  valor_nota     String? @db.VarChar(20)
  sigla_nota     String? @db.VarChar(5)
}

model area {
  id_area Int    @id @default(autoincrement())
  name    String @db.VarChar(150)
  status  String @default("H") @db.VarChar(1)
}

model course {
  id_course     Int     @id @default(autoincrement())
  id_group      Int
  id_teacher    Int
  name          String  @db.VarChar(200)
  position      Int?
  dim_codigo    Int?
  asi_dimension String? @db.Char(1)
  id_area       Int
  hour          Int
  average       String? @db.Char(2)
  percentage    Int?
}

model course_student {
  id_cour_stu Int     @id @default(autoincrement())
  id_student  Int?
  id_course   Int?
  score1      String? @db.VarChar(15)
  score2      String? @db.VarChar(15)
  score3      String? @db.VarChar(15)
  score4      String? @db.VarChar(15)
  valor_nota1 String? @db.VarChar(20)
  valor_nota2 String? @db.VarChar(20)
  valor_nota3 String? @db.VarChar(20)
  valor_nota4 String? @db.VarChar(20)
  sigla_nota1 String? @db.VarChar(5)
  sigla_nota2 String? @db.VarChar(5)
  sigla_nota3 String? @db.VarChar(5)
  sigla_nota4 String? @db.VarChar(5)
  score5      String? @db.VarChar(15)
  valor_nota5 String? @db.VarChar(20)
  sigla_nota5 String? @db.VarChar(5)
}

model enrollment {
  id_enrollment    Int       @id @default(autoincrement())
  id_student       Int?
  id_group         Int?
  year             Int?
  status           String?   @db.VarChar(10)
  reason_desertion String?   @db.LongText
  date_desertion   DateTime? @db.DateTime(0)
}

model featured {
  id_featured Int  @id @default(autoincrement())
  id_group    Int?
  id_student  Int?
}

model group {
  id_group       Int     @id @default(autoincrement())
  id_year        Int?
  level          Int?
  sublevel       String? @db.VarChar(5)
  working_time   String? @db.VarChar(5)
  representative String? @db.VarChar(200)
  periodo_1      String? @db.VarChar(1)
  periodo_2      String? @db.VarChar(1)
  periodo_3      String? @db.VarChar(1)
  periodo_4      String? @db.VarChar(1)
  periodo_5      String? @db.VarChar(1)
}

model indicator_student {
  id_ind_stu   Int     @id @default(autoincrement())
  id_indicator Int?
  id_student   Int?
  score        String? @db.VarChar(20)
  valor_nota   Int?
  sigla_nota   String? @db.VarChar(5)
}

model institution {
  id_institution  Int     @id @default(autoincrement())
  name            String  @db.VarChar(200)
  register        String  @db.VarChar(200)
  direction       String  @db.VarChar(250)
  phone           String  @db.VarChar(50)
  responsable     String  @db.VarChar(250)
  logo            String? @db.VarChar(250)
  user            String  @db.VarChar(250)
  pay_inscription Int
  monthly_pay     Int
  day             String  @db.VarChar(2)
  month           String  @db.VarChar(2)
  year            String  @db.VarChar(4)
  version         Int
  status          String  @db.VarChar(1)
  title           String  @db.VarChar(50)
  message         String  @db.VarChar(250)
  information     String  @db.LongText
}

model observation {
  id_observation Int     @id @default(autoincrement())
  id_student     Int
  id_group       Int
  period         Int
  title          String  @db.VarChar(200)
  description    String? @db.LongText
  note           String? @db.VarChar(20)
}

model recommendation {
  id_recommendation Int     @id @default(autoincrement())
  id_course         Int?
  period            Int?
  description       String? @db.LongText
}

model recommendation_student {
  id_rec_stu        Int     @id @default(autoincrement())
  id_recommendation Int?
  id_student        Int?
  rec_est_nota      String? @db.VarChar(1)
}

model scholar_year {
  id_year   Int     @id
  rector    String? @db.VarChar(200)
  secretary String? @db.VarChar(200)
  comment   String? @db.VarChar(200)
}

model student {
  id_student                 Int       @id @default(autoincrement())
  name                       String?   @db.VarChar(200)
  last_name                  String?   @db.VarChar(200)
  type_id                    Int?
  identification             String?   @db.VarChar(200)
  sex                        String?   @db.VarChar(10)
  direction                  String?   @db.VarChar(200)
  phone                      String?   @db.VarChar(200)
  guardian                   String?   @db.VarChar(200)
  est_foto                   String?   @db.VarChar(200)
  status                     String?   @default("H") @db.VarChar(5)
  birthday                   DateTime? @db.Date
  est_indigena               String?   @db.VarChar(2)
  est_desplasado             String?   @db.VarChar(2)
  est_madre_c                String?   @db.VarChar(2)
  est_desmovilisado          String?   @db.VarChar(2)
  est_sisben                 String?   @db.VarChar(2)
  father                     String    @db.VarChar(150)
  mother                     String    @db.VarChar(150)
  est_ide_acudiente          String    @db.VarChar(100)
  est_ide_madre              String    @db.VarChar(100)
  est_ide_padre              String    @db.VarChar(100)
  est_lugar_nacimiento       String    @db.VarChar(100)
  est_niv_sisben             String    @db.VarChar(100)
  est_niv_estrato            String    @db.VarChar(100)
  est_niv_discapacidad       String    @db.VarChar(100)
  comunidad_indigena         String?   @db.VarChar(70)
  afrodescendiente           String?   @db.VarChar(70)
  comunidad_afrodescendiente String?   @db.VarChar(70)
  barrio                     String?   @db.VarChar(70)
  zona                       String?   @db.VarChar(70)
  estudio_vigencia           String?   @db.VarChar(70)
  institucion_procedencia    String?   @db.VarChar(70)
  grado_procedencia          String?   @db.VarChar(70)
  ano_procedencia            String?   @db.VarChar(70)
  ciudad_procedencia         String?   @db.VarChar(70)
  sistema_salud              String?   @db.VarChar(70)
  tipo_sangra                String?   @db.VarChar(70)
  entidad_afiliado           String?   @db.VarChar(70)
  capacidad_excepcional      String?   @db.VarChar(70)
  codigo                     String?   @db.VarChar(70)
  municipio                  String?   @db.VarChar(70)
  estudio_realizado_madre    String?   @db.VarChar(70)
  profesion_madre            String?   @db.VarChar(70)
  celular_madre              String?   @db.VarChar(70)
  estudio_realizado_padre    String?   @db.VarChar(70)
  profesion_padre            String?   @db.VarChar(70)
  celulat_padre              String?   @db.VarChar(70)
  direccion_padre            String?   @db.VarChar(70)
  necesita_escolar           String?   @db.VarChar(50)
  email                      String?   @db.VarChar(200)
}

model teacher {
  id_teacher      Int     @id @default(autoincrement())
  name            String? @db.VarChar(200)
  last_name       String? @db.VarChar(200)
  type_id         Int?
  identification  String? @db.VarChar(200)
  direction       String? @db.VarChar(200)
  phone           String? @db.VarChar(200)
  email           String? @db.VarChar(200)
  degree          String? @db.VarChar(200)
  pro_descripcion String? @db.VarChar(200)
  pro_eliminado   String? @default("N") @db.VarChar(5)
}

model type_qualification {
  id_type_qual       Int      @id @default(autoincrement())
  tipo_not_codigo    Int?
  name               String?  @db.VarChar(50)
  floor_score        Decimal? @db.Decimal(10, 1)
  ceiling_score      Decimal? @db.Decimal(10, 1)
  tipo_not_cla_sigla String?  @db.VarChar(5)
  year               Int?
}

model user {
  id_user  Int     @id @default(autoincrement())
  user     String? @db.VarChar(200)
  password String? @db.VarChar(200)
  typeu    Int?
  status   String? @db.VarChar(5)
  belongs  String? @db.VarChar(200)
}
