generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model absence {
  id_absence    Int     @id @default(autoincrement())
  id_student    Int?
  id_course     Int?
  day           Int?
  month         Int?
  year          Int?
  hours         Int?
  justification String? @db.Char(2)
  reason        String? @db.VarChar(245)
  period        Int?
}

model achievement {
  id_achievement Int                   @id @default(autoincrement())
  id_course      Int?
  period         Int?
  description    String?               @db.LongText
  course         course?               @relation(fields: [id_course], references: [id_course])
  qualifications achievement_student[]
}

model achievement_student {
  id_achie_stu   Int          @id @default(autoincrement())
  id_achievement Int?
  id_student     Int?
  score          Float?
  score_value    String?      @db.VarChar(20)
  score_acronym  String?      @db.VarChar(5)
  achievement    achievement? @relation(fields: [id_achievement], references: [id_achievement])
  student        student?     @relation(fields: [id_student], references: [id_student])
}

model area {
  id_area Int      @id @default(autoincrement())
  name    String   @db.VarChar(150)
  status  String   @default("H") @db.VarChar(1)
  courses course[]
}

model course {
  id_course      Int              @id @default(autoincrement())
  id_group       Int
  id_area        Int
  area           area             @relation(fields: [id_area], references: [id_area])
  id_teacher     Int
  teacher        teacher          @relation(fields: [id_teacher], references: [id_teacher])
  name           String           @db.VarChar(200)
  position       Int?
  dimension_code Int?
  dimension_type String?          @db.Char(1)
  hour           Int
  average        String?          @db.Char(2)
  percentage     Int?
  group          group?           @relation(fields: [id_group], references: [id_group])
  achievements   achievement[]
  definitives    course_student[]
}

model course_student {
  id_cour_stu    Int      @id @default(autoincrement())
  id_student     Int?
  student        student? @relation(fields: [id_student], references: [id_student])
  id_course      Int?
  course         course?  @relation(fields: [id_course], references: [id_course])
  score1         String?  @db.VarChar(15)
  score2         String?  @db.VarChar(15)
  score3         String?  @db.VarChar(15)
  score4         String?  @db.VarChar(15)
  score_value1   String?  @db.VarChar(20)
  score_value2   String?  @db.VarChar(20)
  score_value3   String?  @db.VarChar(20)
  score_value4   String?  @db.VarChar(20)
  score_acronym1 String?  @db.VarChar(5)
  score_acronym2 String?  @db.VarChar(5)
  score_acronym3 String?  @db.VarChar(5)
  score_acronym4 String?  @db.VarChar(5)
  score5         String?  @db.VarChar(15)
  score_value5   String?  @db.VarChar(20)
  score_acronym5 String?  @db.VarChar(5)
}

model enrollment {
  id_enrollment    Int       @id @default(autoincrement())
  id_student       Int?
  id_group         Int?
  year             Int?
  status           String?   @db.VarChar(10)
  reason_desertion String?   @db.LongText
  date_desertion   DateTime? @db.DateTime(0)
  group            group?    @relation(fields: [id_group], references: [id_group])
  student          student?  @relation(fields: [id_student], references: [id_student])
}

model featured {
  id_featured Int  @id @default(autoincrement())
  id_group    Int?
  id_student  Int?
}

model group {
  id_group       Int          @id @default(autoincrement())
  id_year        Int?
  level          Int?
  sublevel       String?      @db.VarChar(5)
  working_time   String?      @db.VarChar(5)
  representative String?      @db.VarChar(200)
  period_1       String?      @db.VarChar(1)
  period_2       String?      @db.VarChar(1)
  period_3       String?      @db.VarChar(1)
  period_4       String?      @db.VarChar(1)
  period_5       String?      @db.VarChar(1)
  courses        course[]
  enrollments    enrollment[]
}

model indicator_student {
  id_ind_stu    Int     @id @default(autoincrement())
  id_indicator  Int?
  id_student    Int?
  score         String? @db.VarChar(20)
  score_value   Int?
  score_acronym String? @db.VarChar(5)
}

model institution {
  id_institution  Int     @id @default(autoincrement())
  name            String  @db.VarChar(200)
  register        String  @db.VarChar(200)
  direction       String  @db.VarChar(250)
  phone           String  @db.VarChar(50)
  responsible     String  @db.VarChar(250)
  logo            String? @db.VarChar(250)
  user            String  @db.VarChar(250)
  pay_inscription Int
  monthly_pay     Int
  day             String  @db.VarChar(2)
  month           String  @db.VarChar(2)
  year            String  @db.VarChar(4)
  version         Int
  status          String  @db.VarChar(1)
  title           String  @db.VarChar(50)
  message         String  @db.VarChar(250)
  information     String  @db.LongText
  // features        Json?   @default("{\"absences\": true, \"achievements\": true, \"reports\": true, \"enrollments\": true, \"recommendations\": false, \"observations\": true, \"featured_students\": false}")
}

model observation {
  id_observation Int     @id @default(autoincrement())
  id_student     Int
  id_group       Int
  period         Int
  title          String  @db.VarChar(200)
  description    String? @db.LongText
  note           String? @db.VarChar(20)
}

model recommendation {
  id_recommendation Int     @id @default(autoincrement())
  id_course         Int?
  period            Int?
  description       String? @db.LongText
}

model recommendation_student {
  id_rec_stu        Int     @id @default(autoincrement())
  id_recommendation Int?
  id_student        Int?
  score             String? @db.VarChar(1)
}

model scholar_year {
  id_year   Int     @id
  rector    String? @db.VarChar(200)
  secretary String? @db.VarChar(200)
  comment   String? @db.VarChar(200)
  selected  Boolean @default(false)
}

model student {
  id_student           Int                   @id @default(autoincrement())
  name                 String                @db.VarChar(200)
  last_name            String                @db.VarChar(200)
  type_id              Int
  identification       String                @db.VarChar(200)
  sex                  String                @db.VarChar(10)
  direction            String?               @db.VarChar(200)
  phone                String                @db.VarChar(200)
  guardian             String                @db.VarChar(200)
  photo                String?               @db.VarChar(200)
  status               String?               @default("H") @db.VarChar(5)
  birthday             DateTime?             @db.Date
  is_indigenous        String?               @db.VarChar(2)
  is_displaced         String?               @db.VarChar(2)
  is_head_of_household String?               @db.VarChar(2)
  is_demobilized       String?               @db.VarChar(2)
  has_sisben           String?               @db.VarChar(2)
  father               String?               @db.VarChar(150)
  mother               String?               @db.VarChar(150)
  guardian_id          String?               @db.VarChar(100)
  mother_id            String?               @db.VarChar(100)
  father_id            String?               @db.VarChar(100)
  birthplace           String?               @db.VarChar(100)
  sisben_level         String?               @db.VarChar(100)
  socioeconomic_level  String?               @db.VarChar(100)
  disability_level     String?               @db.VarChar(100)
  indigenous_community String?               @db.VarChar(70)
  is_afro_descendant   String?               @db.VarChar(70)
  afro_community       String?               @db.VarChar(70)
  neighborhood         String?               @db.VarChar(70)
  zone                 String?               @db.VarChar(70)
  study_validity       String?               @db.VarChar(70)
  previous_institution String?               @db.VarChar(70)
  previous_grade       String?               @db.VarChar(70)
  previous_year        String?               @db.VarChar(70)
  previous_city        String?               @db.VarChar(70)
  health_system        String?               @db.VarChar(70)
  blood_type           String?               @db.VarChar(70)
  affiliated_entity    String?               @db.VarChar(70)
  exceptional_ability  String?               @db.VarChar(70)
  code                 String?               @db.VarChar(70)
  municipality         String?               @db.VarChar(70)
  mother_education     String?               @db.VarChar(70)
  mother_profession    String?               @db.VarChar(70)
  mother_cellphone     String?               @db.VarChar(70)
  father_education     String?               @db.VarChar(70)
  father_profession    String?               @db.VarChar(70)
  father_cellphone     String?               @db.VarChar(70)
  father_address       String?               @db.VarChar(70)
  school_needs         String?               @db.VarChar(50)
  email                String?               @db.VarChar(200)
  qualifications       achievement_student[]
  enrollments          enrollment[]
  definitives          course_student[]
}

model teacher {
  id_teacher     Int      @id @default(autoincrement())
  name           String?  @db.VarChar(200)
  last_name      String?  @db.VarChar(200)
  type_id        Int?
  identification String?  @db.VarChar(200)
  direction      String?  @db.VarChar(200)
  phone          String?  @db.VarChar(200)
  email          String?  @db.VarChar(200)
  degree         String?  @db.VarChar(200)
  deleted        String?  @default("N") @db.VarChar(5)
  courses        course[]
}

model type_qualification {
  id_type_qual           Int      @id @default(autoincrement())
  type_code              Int?
  name                   String?  @db.VarChar(50)
  floor_score            Decimal? @db.Decimal(10, 1)
  ceiling_score          Decimal? @db.Decimal(10, 1)
  classification_acronym String?  @db.VarChar(5)
  year                   Int?
}

model user {
  id_user  Int     @id @default(autoincrement())
  user     String? @db.VarChar(200)
  password String? @db.VarChar(200)
  typeu    Int?
  status   String? @db.VarChar(5)
  belongs  String? @db.VarChar(200)
}
